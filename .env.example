# Copy to .env on the server (never commit the real .env - it's already in
# .gitignore). deploy/docker-provision.sh generates DJANGO_SECRET_KEY for
# you; everything else here you fill in once.

# Which image docker-compose.yml pulls. The pipeline sets this automatically
# via `IMAGE=ghcr.io/<owner>/<repo>:<sha> docker compose ... up -d`; for a
# manual run, ghcr.io/<owner>/<repo>:latest works too.
IMAGE=ghcr.io/OWNER/REPO:latest

DJANGO_SECRET_KEY=generate-me-see-deploy-docker-provision.sh
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=payroll.nextmedia.co.ug
DJANGO_CSRF_TRUSTED_ORIGINS=https://payroll.nextmedia.co.ug

# Optional - payslip emails just log to the container's stdout
# (docker compose logs) until these are set:
# DJANGO_EMAIL_HOST=smtp.yourhost.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_DEFAULT_FROM_EMAIL=payroll@nextmedia.co.ug
